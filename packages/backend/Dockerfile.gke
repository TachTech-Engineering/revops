FROM python:3.11-slim

WORKDIR /app

# Install git for cloning SDK
RUN apt-get update && apt-get install -y git && rm -rf /var/lib/apt/lists/*

# Copy and install requirements
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Clone and install panther_sdk from GitHub
RUN git clone https://github.com/TachTech-Engineering/panther_sdk.git /app/panther_sdk && \
    pip install --no-cache-dir -e /app/panther_sdk

# Copy application
COPY app ./app

# Create non-root user and set permissions
RUN useradd --create-home --shell /bin/bash appuser && \
    chown -R appuser:appuser /app

USER appuser

ENV PYTHONPATH=/app:/app/panther_sdk

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
