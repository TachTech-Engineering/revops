FROM node:20-alpine

WORKDIR /app

# Install pnpm (pinned to match root packageManager)
RUN npm install -g pnpm@8.14.0

# Copy package files
COPY package.json pnpm-lock.yaml ./

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source
COPY . .

EXPOSE 3000

CMD ["pnpm", "dev", "--host", "0.0.0.0"]
